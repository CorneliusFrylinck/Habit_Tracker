@* Renders a habit's own entries if it's a leaf, or an accordion of its sub-habits (each
   recursing into this same component) if it has any - matches the tree to arbitrary depth.
   Each sub-habit row gets a "View" link if it has its own sub-habits (drill in instead of
   tracking), or an "Add entry" button if it's a leaf (nothing further to drill into). *@

@if (Node.SubHabits.Count > 0)
{
    <ul class="habit-node-list">
        @foreach (var child in Node.SubHabits)
        {
            <li>
                <details>
                    <summary>
                        @if (child.IsCompletable)
                        {
                            <HabitProgressRing PercentComplete="child.CompletionPercentage" />
                        }
                        <span class="habit-name">@child.Name</span>
                        <span class="habit-node-action">
                            @if (child.SubHabits.Count > 0)
                            {
                                <a href="/habits/@child.Id" class="icon-btn" title="View">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                </a>
                            }
                            else
                            {
                                <button type="button" class="icon-btn" title="Add entry"
                                        onclick="event.preventDefault(); openAddEntryModal('@child.Id', '@child.IsCompletable.ToString().ToLowerInvariant()', '@child.CompletionMethod', '@child.Unit', '@child.UnitPlural')">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="12" y1="5" x2="12" y2="19" />
                                        <line x1="5" y1="12" x2="19" y2="12" />
                                    </svg>
                                </button>
                            }
                        </span>
                    </summary>
                    <div class="habit-node-detail">
                        <HabitNodeView Node="child" />
                    </div>
                </details>
            </li>
        }
    </ul>
}
else if (Node.Entries.Count == 0)
{
    <p>No entries tracked yet.</p>
}
else
{
    <ul class="entry-list">
        @foreach (var entry in Node.Entries)
        {
            <li>
                <span>@entry.TrackedAt.ToLocalTime().ToString("f")</span>
                @if (entry.Amount is not null)
                {
                    <span class="badge bg-info">
                        @entry.Amount
                        @if (Node.UnitPlural is not null)
                        {
                            @(entry.Amount == 1 ? Node.Unit : Node.UnitPlural)
                        }
                    </span>
                }
                else if (Node.IsCompletable)
                {
                    <span class="badge @(entry.IsCompleted ? "bg-success" : "bg-secondary")">
                        @(entry.IsCompleted ? "Completed" : "Not completed")
                    </span>
                }
            </li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired]
    public HabitTreeNodeDto Node { get; set; } = null!;
}
